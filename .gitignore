# Build outputs
bin/
obj/
artifacts/
*.nupkg
*.snupkg

# IDE
.vs/
.idea/
.vscode/
*.suo
*.user

# Logs and temp files
*.log
TestResults/

# OS files
.DS_Store
Thumbs.db

# Sample runtime data (persistence is app-owned and generated at runtime)
samples/**/data/
!samples/**/data/.gitkeep

# Docs output
docs-output/
docs/api/*.yml
docs/api/.manifest

# Development config overlay — per-machine, never committed
**/CodeLogic.Development.json
*.actual.html

# Sample state (CodeLogic config/logs, JSON stores, DataProtection keys)
samples/*/data/
