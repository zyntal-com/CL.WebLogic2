<Project>
  <!-- Shared NuGet metadata for every CodeLogic.WebLogic* package -->
  <PropertyGroup>
    <Authors>Zyntal.com</Authors>
    <Copyright>Copyright © 2026 Zyntal.com</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/zyntal-com/CL.WebLogic2</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zyntal-com/CL.WebLogic2</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Language and analysis defaults (same as CodeLogic) -->
  <PropertyGroup>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Version is COMPOSED at build time, never hardcoded in a csproj.

      Major.Minor  ← repo-root version.txt (e.g. "4.9"), hand-controlled. It follows
                     the CodeLogic line this toolkit is built against.
      Patch        ← the $(Patch) property. CI passes the GitHub run number
                     (-p:Patch=<run_number> or the whole -p:Version=...);
                     a local/dev build leaves it 0, giving a stable "4.9.0".

    CI publishes 4.9.<run_number>+<short-sha> (release) or
    4.9.<run_number>-preview+<short-sha> (prerelease). The run number is the
    monotonic, NuGet-orderable component. The git sha is SemVer build-metadata:
    stripped by nuget.org, kept in InformationalVersion for provenance.

    AssemblyVersion / FileVersion are pinned to Major.Minor.0.0 so CLR binding
    stays fixed per minor and every patch loads interchangeably.
    AssemblyVersion itself is derived in Directory.Build.targets.
  -->
  <PropertyGroup>
    <_RootVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)version.txt').Trim())</_RootVersion>
    <Patch Condition="'$(Patch)' == ''">0</Patch>
    <Version Condition="'$(Version)' == ''">$(_RootVersion).$(Patch)</Version>
    <FileVersion>$(_RootVersion).0.0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>

  <!--
    Version the samples consume CodeLogic.WebLogic at. CI packs to a local feed and
    passes the exact -ci version so the samples build against what was just packed.
  -->
  <PropertyGroup>
    <WebLogicPackageVersion Condition="'$(WebLogicPackageVersion)' == ''">$(Version)</WebLogicPackageVersion>
  </PropertyGroup>
</Project>
