<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CL.WebLogic.IntegrationTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Templates a "plugin" ships inside its assembly (TemplateContributionTests). -->
    <EmbeddedResource Include="Theming\EmbeddedTheme\**\*.html" LogicalName="plugin-theme/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Theming\EmbeddedAssets\**\*" LogicalName="plugin-assets/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CL.WebLogic\CL.WebLogic.csproj" />
    <ProjectReference Include="..\..\src\CL.WebLogic.Testing\CL.WebLogic.Testing.csproj" />
  </ItemGroup>
</Project>
