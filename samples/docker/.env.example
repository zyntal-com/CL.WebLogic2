# Copy to .env and adjust. Every value is optional; the defaults run on localhost.

# ── Starter website ───────────────────────────────────────────────────────────
STARTER_PORT=5080
STARTER_PUBLIC_URL=http://localhost:5080
# Password of the "admin" account created on first start (min. 10 chars, not containing "admin").
# Leave empty to generate one: it is printed once in `docker compose logs starter`.
STARTER_ADMIN_PASSWORD=
# "Sign in through Steam" (OpenID; needs outbound HTTPS to steamcommunity.com).
STEAM_SIGNIN=false

# ── MiniBlog ──────────────────────────────────────────────────────────────────
MINIBLOG_PORT=5081
MINIBLOG_PUBLIC_URL=http://localhost:5081
MINIBLOG_ADMIN_PASSWORD=
# Secret mixed into password hashes. Users live in MySQL, so keep this with the database
# (if empty, one is generated into the miniblog-data volume: losing that volume breaks every password).
MINIBLOG_PASSWORD_PEPPER=
MYSQL_PASSWORD=miniblog-demo-password
MYSQL_ROOT_PASSWORD=root-demo-password

# ── Shared ────────────────────────────────────────────────────────────────────
MAILPIT_PORT=8025
# Serve /_weblogic/explorer in production (only to accounts with the weblogic.explorer permission).
DEMO_EXPLORER=true

# ── Behind the Caddy proxy (docker compose --profile proxy up) ────────────────
# Real DNS names pointing at this machine; Caddy fetches certificates for them.
# Set the *_PUBLIC_URL values above to https://<domain> as well.
STARTER_DOMAIN=starter.localhost
BLOG_DOMAIN=blog.localhost
# The apps trust X-Forwarded-* only from the proxy container.
TRUSTED_PROXIES=
DEMO_HTTPS=false
