<Project Sdk="Microsoft.NET.Sdk">
  <!--
    MiniBlog's data layer on CL.Data: posts and app documents. The WebLogic stores (users,
    sessions, recovery codes, ...) come from the CodeLogic.WebLogic.Data add-on. Shared by the
    host and the admin plugin. The host picks the database (MySQL) — never the core toolkit.
  -->
  <PropertyGroup>
    <RootNamespace>MiniBlog.Data</RootNamespace>
    <UsesWebLogic>true</UsesWebLogic>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="CodeLogic" />
    <PackageReference Include="CodeLogic.Data" />
  </ItemGroup>
</Project>
