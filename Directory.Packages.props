<Project>
  <!--
    Central package management. Dependency rule (see AGENTS.md):
      - runtime: CodeLogic and CodeLogic.* packages only, plus the ASP.NET shared framework
      - tests only: xunit, xunit.runner.visualstudio, Microsoft.NET.Test.Sdk (same as CodeLogic)
    CodeLogic.Data (the provider-neutral core) is referenced only by the optional add-on
    src/CL.WebLogic.Data (its own package). Database providers (CodeLogic.Data.MySql, ...) are
    referenced only by samples and tests: the app chooses and loads its provider.
    CodeLogic 5.0 is in preview, so WebLogic 5.0 ships -preview packages until it is stable.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="CodeLogic">
    <PackageVersion Include="CodeLogic" Version="5.0.32-preview" />
    <PackageVersion Include="CodeLogic.GitHelper" Version="5.0.113-preview" />
    <PackageVersion Include="CodeLogic.NetUtils" Version="5.0.113-preview" />
    <PackageVersion Include="CodeLogic.Storage" Version="5.0.113-preview" />
    <PackageVersion Include="CodeLogic.TwoFactorAuth" Version="5.0.113-preview" />
    <PackageVersion Include="CodeLogic.Mail" Version="5.0.113-preview" />
    <PackageVersion Include="CodeLogic.Data" Version="5.0.113-preview" />
  </ItemGroup>

  <ItemGroup Label="Database providers (samples and tests only)">
    <PackageVersion Include="CodeLogic.Data.MySql" Version="5.0.113-preview" />
    <PackageVersion Include="CodeLogic.Data.PostgreSql" Version="5.0.113-preview" />
    <PackageVersion Include="CodeLogic.Data.SqlServer" Version="5.0.113-preview" />
    <PackageVersion Include="CodeLogic.Data.Sqlite" Version="5.0.113-preview" />
  </ItemGroup>

  <ItemGroup Label="Samples only">
    <!-- Used when a sample builds with -p:WebLogicFromPackage=true (CI, Docker). -->
    <PackageVersion Include="CodeLogic.WebLogic" Version="$(WebLogicPackageVersion)" />
    <PackageVersion Include="CodeLogic.WebLogic.Data" Version="$(WebLogicPackageVersion)" />
    <PackageVersion Include="CodeLogic.WebLogic.ExternalLogins" Version="$(WebLogicPackageVersion)" />
  </ItemGroup>

  <ItemGroup Label="Tests only">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
